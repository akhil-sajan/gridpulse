[sqlfluff]
dialect = databricks
templater = jinja
max_line_length = 100
# LT05 line length: ruff-style 100 is checked by reviewers, long CASE lines are fine.
# ST06 column order, ST07 USING joins, ST09 join condition order, AM06 GROUP BY style:
# style preferences that would only reorder working SQL.
exclude_rules = LT05, ST06, ST07, ST09, AM06

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
# Python stand-ins for dbt_utils macros (see sqlfluff_libs/).
library_path = sqlfluff_libs

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
